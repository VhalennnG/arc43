# =============================================================================
# arc43 — Configuration Environment Variables
# =============================================================================
# Copy this file to `.env` and adjust values as needed.
# All values shown are defaults used when the variable is not set.
# =============================================================================

# --- LLM Model Configuration ---
# Context window size (total tokens for prompt + output).
# Qwen2.5-8B supports up to 32768. Higher = more RAM usage.
# On 8GB RAM: 20480 is safe. Lower to 8192 if memory issues occur.
LLM_N_CTX=20480

# Maximum tokens the LLM can generate in its response.
# Higher = allows longer JSON output but uses more time/memory.
LLM_MAX_TOKENS=4096

# Temperature for LLM text generation (0.0 = deterministic, 1.0 = creative).
# For structured extraction, keep very low.
LLM_TEMPERATURE=0.1

# --- Model File Paths (relative to project root) ---
LLM_MODEL_FILENAME=apertus-sea-lion-v4-8b-it-q4_k_m.gguf
EMBEDDING_MODEL_FILENAME=bge-m3-f16.gguf

# --- Embedding Model Configuration ---
EMBEDDING_N_CTX=1024

# --- OCR Configuration ---
# Vision OCR recognition level: 0 = Accurate, 1 = Fast
OCR_RECOGNITION_LEVEL=0
